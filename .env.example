# Copy to .env and fill in values you want active. The pipeline picks up these
# variables at runtime via src/llm/provider.py and src/rag/embeddings.py.

# --- LLM backend ----------------------------------------------------------
# auto | gemini | openai_compatible (alias: lmstudio) | ollama | rule_based
LLM_BACKEND=auto

# Gemini (LangChain). Required when LLM_BACKEND=gemini or auto-select picks it.
# Get a key from https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI-compatible server: LM Studio, vLLM, llama.cpp server, oobabooga, ...
# LM Studio default URL is http://localhost:1234/v1. Leave OPENAI_MODEL empty
# to auto-discover the loaded model via GET /v1/models.
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=
# OPENAI_API_KEY=lm-studio   # any non-empty string; LM Studio ignores the value

# Ollama local server. Required when LLM_BACKEND=ollama or auto-select picks it.
# Run a daemon with `ollama serve` and pull a small instruction model.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# Shared LLM knobs.
# LLM_TEMPERATURE=0.0
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_TIMEOUT_SECONDS=30
# LLM_ENABLE_CACHE=1
# LLM_CACHE_PATH=data/llm_cache.sqlite

# --- Embeddings -----------------------------------------------------------
# semantic | tfidf
EMBEDDING_BACKEND=semantic
# Any sentence-transformers model. all-MiniLM-L6-v2 is small (~80MB), fast,
# and good enough for skill-phrase normalization.
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
